{
  "name": "strike-v",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "h": "node scripts/help.js",
    "help": "node scripts/help.js",
    "dev": "vite",
    "dev:bg": "node -e \"require('child_process').spawn('npx',['vite'],{detached:true,stdio:'ignore'}).unref()\"",
    "dev:pm2": "pnpm exec pm2 start ecosystem.config.cjs",
    "dev:pm2:stop": "pnpm exec pm2 stop vite-dev",
    "dev:pm2:restart": "pnpm exec pm2 restart vite-dev",
    "dev:pm2:status": "pnpm exec pm2 status vite-dev",
    "dev:pm2:logs": "pnpm exec pm2 logs vite-dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "pack:docs": "repomix --include \"docs/**\" --output repomix-docs.xml",
    "pack:src": "repomix --include \"src/**\" --output repomix-src.xml",
    "pack:all": "repomix --output repomix-all.xml",
    "format:docs": "prettier --write --no-ignore docs/*.md README.md .agent/workflows/*.md",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:docs": "prettier --check --no-ignore docs/*.md README.md .agent/workflows/*.md",
    "diff": "git add -N . && git diff",
    "deploy": "vite build && gh-pages -d dist",
    "review:fetch": "node scripts/fetch-pr-comments.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "floating-vue": "^5.2.2",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/browser": "^4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/ui": "^4.0.16",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-no-comments": "^1.1.10",
    "eslint-plugin-vue": "^10.6.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.0.0",
    "happy-dom": "^20.1.0",
    "pm2": "^5.3.1",
    "prettier": "^3.7.4",
    "repomix": "^1.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^4.0.16",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.2"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}